{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atrium",
  "version": "1.7.0",
  "identifier": "com.met0n.atrium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atrium",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'none'"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"],
        "script-src": ["'self'", "atrium-plugin:", "http://atrium-plugin.localhost"],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "atrium-plugin:",
          "http://atrium-plugin.localhost"
        ],
        "img-src": [
          "'self'",
          "data:",
          "asset:",
          "http://asset.localhost",
          "atrium-plugin:",
          "http://atrium-plugin.localhost",
          "http:",
          "https:"
        ],
        "media-src": ["'self'", "asset:", "http://asset.localhost", "mediastream:", "blob:"],
        "font-src": ["'self'", "atrium-plugin:", "http://atrium-plugin.localhost"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://registry.npmjs.org",
          "https://api.github.com"
        ],
        "worker-src": ["'none'"],
        "frame-src": ["asset:", "http://asset.localhost", "http:", "https:"]
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "publisher": "Atrium contributors",
    "shortDescription": "Multi-agent coding workspace",
    "longDescription": "Atrium is a desktop workspace for running, organizing, and resuming coding agents and shells side by side, with real terminals, split panes, and persistent layouts. Based on Alethe by Kauã Miguel.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/met0n/atrium/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
